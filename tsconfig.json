{
  // Build ESM (dist/esm). O build CJS estende este arquivo (tsconfig.cjs.json).
  // src/core.ts é cópia do núcleo do widget: as regras aqui não podem ser mais duras que as de lá
  // (por isso sem noUncheckedIndexedAccess).
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "./src",
    "outDir": "./dist/esm",
    "declaration": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts"]
}
